<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- فقط HTTPS مجاز است — سایت باید SSL داشته باشد -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
